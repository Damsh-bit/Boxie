# ─────────────────────────────────────────────────────────────────────────────
# Boxie — variables de entorno
#
# Copiar a .env.local para desarrollo. En producción/preview viven SOLO en
# Vercel (Settings → Environment Variables). Nunca commitear valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio, sin barra final. Se usa en mails, back_urls de
# Mercado Pago y en las imágenes de Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. En local salen de `npm run db:start` (API URL + anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreto: acceso total a la base. Solo del lado del servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Secretos propios de la app (generar con `openssl rand -base64 32`).
# SESSION_SECRET firma las cookies del editor y del checkout (se puede rotar:
# solo cierra sesiones). TOKEN_ENCRYPTION_KEY cifra en reposo el link del
# regalo para poder volver a mostrarlo; rotarla requiere re-cifrar.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Pagos. `fake` simula Mercado Pago (solo desarrollo/E2E, se rechaza en producción).
PAYMENTS_PROVIDER=fake
# Access token de Mercado Pago (TEST-… en sandbox, APP_USR-… en producción).
MP_ACCESS_TOKEN=
# Clave secreta de la firma de webhooks (Tus integraciones → Webhooks).
MP_WEBHOOK_SECRET=

# Mails transaccionales (Resend). Sin API key, los mails se escriben en el log.
RESEND_API_KEY=
MAIL_FROM="Boxie <hola@boxiedigital.com.ar>"
MAIL_REPLY_TO=ayuda@boxiedigital.com.ar

# Host del panel de administración. Si se define, /admin solo responde ahí.
ADMIN_HOST=

# Monitoreo de errores (opcional).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Modo demo: catálogo desde supabase/seed, sin base ni cobro. Solo para
# mostrar el producto en un deploy sin secretos. Nunca en producción.
DEMO_MODE=
# Usuario del panel (/admin) en modo demo. Sin definir: admin@boxie.demo /
# boxie-admin, solo en local y CI; en Vercel, sin clave el panel queda cerrado.
ADMIN_DEMO_EMAIL=
ADMIN_DEMO_PASSWORD=

# Secreto del cron de Vercel (vencimientos). Opcional en desarrollo.
CRON_SECRET=
